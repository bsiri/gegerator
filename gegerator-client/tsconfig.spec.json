/* To learn more about this file see: https://angular.io/config/tsconfig. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["vitest","vite/client"],
    "outDir": "./out-tsc/spec"
  },
  "files": [
    "src/polyfills.ts"
  ],
  "include": [
    "src/**/*.spec.ts",
    "src/**/*.d.ts",
  ],
  // Exclude broken tests and node_modules from compilation
  // since they are not scheduled to run anyway.
  "exclude": [
    "test-waiting-migration/**",
    "node_modules/**"
  ]
}
